# One-zone chemistry test. Fix initial species mass fractions in
# Simulation_initBlock.F90 (all zero by default) before running.

useKromeChemistry = .true.

# Hydro off: it only declares the mesh variables (dens/pres/eint/...); with it
# active its CFL (sound-crossing time of the cell) would needlessly throttle dt.
useHydro = .false.

geometry = "cartesian"

xmin = 0.0
xmax = 1.0
ymin = 0.0
ymax = 1.0
zmin = 0.0
zmax = 1.0

xl_boundary_type = "reflect"
xr_boundary_type = "reflect"
yl_boundary_type = "reflect"
yr_boundary_type = "reflect"
zl_boundary_type = "reflect"
zr_boundary_type = "reflect"

nblockx = 1
nblocky = 1
nblockz = 1
lrefine_min = 1
lrefine_max = 1

gamma = 1.6666667

# Initialise thermodynamics from density+temperature (initBlock sets TEMP, not EINT).
eosModeInit = "dens_temp"

sim_initDens = 1.0e-20
sim_initTemp = 1.0e4

# Floors low enough not to clamp typical chemistry densities/temperatures.
smlrho = 1.0e-30
smallt = 1.0

krome_density_threshold = 0.0
krome_temp_floor        = 1.0

nend   = 100000
tmax   = 1.0e14
dtinit = 1.0e8
dtmin  = 1.0e6
dtmax  = 1.0e12

basenm     = "cie_"

# $JAFF REPEAT idx, specie_with_normalized_sign IN species_with_normalized_sign $[POS j NEG k]$
plot_var_$idx+1$ = "$specie_with_normalized_sign$"
# $JAFF END

# $JAFF SUB nspec
plot_var_$nspec+1$ = "temp"
plot_var_$nspec+2$ = "dens"
# $JAFF END

plotFileIntervalTime       = 1.0e13
checkpointFileIntervalTime = 5.0e13
